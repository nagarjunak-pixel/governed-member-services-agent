# Path to the Emids supplied pack directory (contains kb/, eval/, tools/, mock_services/)
PACK_DIR=../pack

# Mock member-services API base URL
MOCK_API_BASE_URL=http://127.0.0.1:8090

# Tenant bearer tokens & third-party provider directory key
# (Values come from the supplied pack's data/README.md; leave blank or override in your local .env)
TENANT_TOKEN_PLAN_A=
TENANT_TOKEN_PLAN_B=
DIRECTORY_API_KEY=

# OpenAI-compatible LLM provider configuration
# Default: local Ollama server
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.6:35b-a3b-agent
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=60

# Optional per-1M token cost estimates (USD) for conversation budget tracking
# Set to 0.0 for local Ollama; override for cloud models (e.g. GPT-4o-mini, Claude Haiku, Gemini Flash)
LLM_INPUT_COST_PER_1M=0.0
LLM_OUTPUT_COST_PER_1M=0.0

# Per-conversation gateway budgets
BUDGET_MAX_STEPS=10
BUDGET_MAX_COST_USD=0.03
BUDGET_MAX_LATENCY_MS=30000

# Optional JSONL trace output directory (PHI-redacted)
TRACE_DIR=./traces
